---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, promoImage, githubUrl, stack } = Astro.props;
const getToolClass = (tool: string) => `tool-${tool.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={promoImage} />
	</head>

	<body>
		<div class="project-page">
			<Header />
			<main class="project-shell">
				<a class="back-link" href="/projects" aria-label="Back to projects">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M15 6L9 12L15 18" />
					</svg>
				</a>

				<article class="project-layout">
					<header class="project-summary">
						<h1>{title}</h1>
						<p>{description}</p>
						{
							stack?.length && (
								<ul class="project-tools" aria-label="Tools used">
									{stack.map((item) => (
										<li class={getToolClass(item)}>{item}</li>
									))}
								</ul>
							)
						}
					</header>

					<section class="project-body" aria-label={title}>
						<figure class="project-visual">
							<Image width={1100} height={680} src={promoImage} alt="" />
							<figcaption>
								<a href={githubUrl} target="_blank" rel="noreferrer">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path
											fill="currentColor"
											d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.15c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18.92-.26 1.9-.38 2.88-.39.98 0 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.16c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
										/>
									</svg>
									View on GitHub
								</a>
							</figcaption>
						</figure>

						<div class="project-content">
							<slot />
						</div>
					</section>
				</article>
			</main>
		</div>
	</body>
</html>

<style>
	.project-page {
		min-height: 100vh;
		background: #fff;
	}
	.project-shell {
		width: min(1200px, 100% - 3em);
		max-width: none;
		margin-inline: auto;
		padding: clamp(3rem, 7vh, 5rem) 0 5rem;
		position: relative;
	}
	.back-link {
		position: absolute;
		top: clamp(2.1rem, 5vh, 3.8rem);
		left: 0;
		width: 2rem;
		height: 2rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #111;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}
	.back-link:hover {
		opacity: 0.72;
		transform: translateX(-3px);
	}
	.back-link svg {
		width: 1.5rem;
		height: 1.5rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.project-layout {
		display: grid;
		grid-template-columns: minmax(220px, 320px) minmax(520px, 1fr);
		gap: clamp(3rem, 7vw, 6rem);
		align-items: start;
		padding-top: 1rem;
		animation: project-in 0.5s ease both;
	}
	.project-summary {
		min-height: 70vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.project-summary h1 {
		max-width: 10ch;
		margin: 0 0 1.4rem;
		color: #111;
		font-family: var(--font-nunito), sans-serif;
		font-size: clamp(2.25rem, 4vw, 3.5rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: 0;
	}
	.project-summary p {
		max-width: 30ch;
		margin: 0;
		color: #222;
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.88rem;
		line-height: 1.75;
	}
	.project-tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 1.7rem 0 0;
		padding: 0;
		list-style: none;
	}
	.project-tools li {
		display: inline-flex;
		align-items: center;
		padding: 0.16rem 0.55rem;
		border: 1px solid var(--tool-border, #111);
		border-radius: 999px;
		background: var(--tool-bg, #fff);
		color: var(--tool-text, #111);
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1.4;
	}
	.project-tools .tool-astro {
		--tool-bg: #f4ecff;
		--tool-border: #7b3ff2;
		--tool-text: #4a208f;
	}
	.project-tools .tool-typescript {
		--tool-bg: #eaf3ff;
		--tool-border: #3178c6;
		--tool-text: #174b82;
	}
	.project-tools .tool-markdown {
		--tool-bg: #f3f5f7;
		--tool-border: #6b7280;
		--tool-text: #2f3640;
	}
	.project-tools .tool-python {
		--tool-bg: #fff6d7;
		--tool-border: #3776ab;
		--tool-text: #2b5f8a;
	}
	.project-tools .tool-sql {
		--tool-bg: #eaf8f1;
		--tool-border: #1f9d68;
		--tool-text: #146246;
	}
	.project-tools .tool-databricks {
		--tool-bg: #fff0ec;
		--tool-border: #ff5f46;
		--tool-text: #a83222;
	}
	.project-body {
		padding-top: 2.2rem;
	}
	.project-visual {
		margin: 0 0 3.4rem;
	}
	.project-visual img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 8px;
	}
	.project-visual figcaption {
		margin-top: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		align-items: flex-start;
	}
	.project-visual a {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: #111;
		font-family: var(--font-nunito), sans-serif;
		font-size: 0.9rem;
		font-weight: 800;
		text-decoration: none;
	}
	.project-visual a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.project-visual svg {
		width: 1.15rem;
		height: 1.15rem;
	}
	.project-content {
		max-width: 72ch;
		color: #333;
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.88rem;
		line-height: 1.85;
	}
	.project-content :global(h2),
	.project-content :global(h3) {
		margin: 2.6rem 0 1rem;
		color: #111;
		font-family: var(--font-nunito), sans-serif;
		font-weight: 800;
		line-height: 1.15;
	}
	.project-content :global(h2) {
		font-size: 1.35rem;
	}
	.project-content :global(h3) {
		font-size: 1.08rem;
	}
	.project-content :global(p) {
		margin: 0 0 1.4rem;
	}
	.project-content :global(ul),
	.project-content :global(ol) {
		margin: 0 0 1.6rem;
		padding-left: 1.2rem;
	}
	.project-content :global(li) {
		margin-bottom: 0.45rem;
	}
	.project-content :global(code) {
		padding: 0.15rem 0.35rem;
		border: 1px solid #e6e4e1;
		border-radius: 4px;
		background: #f8f7f5;
		color: #111;
		font-size: 0.82em;
	}
	.project-content :global(pre) {
		max-width: 100%;
		margin: 2rem 0;
		padding: 1.1rem 1.2rem;
		overflow-x: auto;
		border-radius: 8px;
		background: #111;
		color: #f7f7f7;
		line-height: 1.7;
	}
	.project-content :global(pre code) {
		all: unset;
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.82rem;
	}
	@keyframes project-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.project-layout {
			animation: none;
		}
	}
	@media (max-width: 820px) {
		.project-shell {
			padding-top: 4.5rem;
		}
		.back-link {
			top: 1.3rem;
		}
		.project-layout {
			grid-template-columns: 1fr;
			gap: 2.75rem;
		}
		.project-summary {
			min-height: auto;
		}
		.project-body {
			padding-top: 0;
		}
	}
</style>
