---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AvatarImage from '../assets/avatar.svg';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, seoTitle, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;
const publishStamp = `${pubDate.getDate()}.${pubDate.getMonth() + 1}`;
const fullDate = pubDate.toLocaleDateString('en-us', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
const updatedStamp = updatedDate?.toLocaleDateString('en-us', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={seoTitle ?? title} description={description} image={heroImage} tags={tags} />
	</head>

	<body>
		<div class="post-page">
			<Header />
			<main class="post-shell">
				<a class="back-link" href="/blog" aria-label="Back to blog">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M15 6L9 12L15 18" />
					</svg>
				</a>

				<article class="post-layout">
					<header class="post-hero">
						<h1>{title}</h1>
						{
							tags.length > 0 && (
								<ul class="post-tags" aria-label="Post tags">
									{tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							)
						}
						<div class="post-meta">
							<Image class="post-avatar" width={42} height={42} src={AvatarImage} alt="Jonathan Vázquez" />
							<div class="post-meta-row">
								<span>Post</span>
								<span>{fullDate}</span>
								{updatedStamp && <span>Updated {updatedStamp}</span>}
							</div>
						</div>
					</header>

					<section class="post-body" aria-label={title}>
						<div class="post-intro">
							<p>{description}</p>
							<span>{publishStamp}</span>
						</div>

						<div class="post-content">
							<slot />
							{
								heroImage && (
									<div class="post-image">
										<Image width={1100} height={620} src={heroImage} alt="" />
									</div>
								)
							}
						</div>
					</section>
				</article>
			</main>
			<dialog class="image-viewer" aria-label="Expanded image viewer">
				<button class="image-viewer-close" type="button" aria-label="Close image viewer">×</button>
				<img src="" alt="" />
			</dialog>
		</div>
	</body>
</html>

<script>
	const viewer = document.querySelector<HTMLDialogElement>('.image-viewer');
	const viewerImage = viewer?.querySelector<HTMLImageElement>('img');
	const viewerClose = viewer?.querySelector<HTMLButtonElement>('.image-viewer-close');
	let closeTimer: number | undefined;

	if (viewer && viewerImage) {
		function closeViewer() {
			if (!viewer || !viewer.open) return;
			viewer.dataset.closing = 'true';
			window.clearTimeout(closeTimer);
			closeTimer = window.setTimeout(() => {
				viewer.close();
				delete viewer.dataset.closing;
			}, 180);
		}

		document.querySelectorAll<HTMLImageElement>('.post-content img').forEach((image) => {
			image.tabIndex = 0;
			image.setAttribute('role', 'button');
			image.setAttribute('aria-label', image.alt ? `Open image: ${image.alt}` : 'Open image');

			function openImage() {
				const imageUrl = image.currentSrc || image.src;
				if (!imageUrl) return;
				viewerImage.src = imageUrl;
				viewerImage.alt = image.alt || '';
				if (typeof viewer.showModal === 'function') {
					delete viewer.dataset.closing;
					viewer.showModal();
				} else {
					window.open(imageUrl, '_blank', 'noopener,noreferrer');
				}
			}

			image.addEventListener('click', openImage);
			image.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					openImage();
				}
			});
		});

		viewerClose?.addEventListener('click', closeViewer);
		viewer.addEventListener('click', (event) => {
			if (event.target === viewer) closeViewer();
		});
		viewer.addEventListener('cancel', (event) => {
			event.preventDefault();
			closeViewer();
		});
		viewer.addEventListener('close', () => {
			viewerImage.removeAttribute('src');
			viewerImage.alt = '';
		});
	}
</script>

<style>
	.post-page {
		min-height: 100vh;
		background: #fff;
	}
	.post-shell {
		width: min(1200px, 100% - 3em);
		max-width: none;
		margin-inline: auto;
		padding: clamp(3rem, 7vh, 5rem) 0 5rem;
		position: relative;
	}
	.back-link {
		position: absolute;
		top: clamp(2.1rem, 5vh, 3.8rem);
		left: 0;
		width: 2rem;
		height: 2rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #111;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}
	.back-link:hover {
		color: #111;
		opacity: 0.72;
		transform: translateX(-3px);
	}
	.back-link svg {
		width: 1.5rem;
		height: 1.5rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.post-layout {
		display: grid;
		grid-template-columns: minmax(240px, 360px) minmax(460px, 1fr);
		gap: clamp(3rem, 7vw, 6rem);
		align-items: start;
		padding-top: 1rem;
		animation: post-in 0.5s ease both;
	}
	.post-hero {
		min-width: 0;
		min-height: 70vh;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding-top: 2.4rem;
	}
	.post-hero h1 {
		max-width: 13ch;
		margin: 0;
		color: #111;
		font-family: var(--font-nunito), sans-serif;
		font-size: clamp(1.7rem, 2.4vw, 2.35rem);
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: 0;
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 1.2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.post-tags li {
		border: 1px solid #e6e4e1;
		border-radius: 999px;
		padding: 0.18rem 0.55rem;
		color: #555;
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.68rem;
		line-height: 1.35;
	}
	.post-meta {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		align-items: flex-start;
		color: #111;
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.78rem;
		line-height: 1.5;
	}
	.post-avatar {
		width: 2.85rem;
		height: 2.85rem;
		border: 2px solid #111;
		border-radius: 999px;
		object-fit: cover;
	}
	.post-meta-row {
		display: flex;
		gap: 1.2rem;
		align-items: baseline;
	}
	.post-meta-row span:first-child {
		color: #777;
	}
	.post-body {
		min-width: 0;
		padding-top: 2.1rem;
	}
	.post-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: start;
		margin-bottom: clamp(5rem, 13vh, 8.5rem);
	}
	.post-intro p {
		max-width: 48ch;
		margin: 0;
		color: #222;
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.9rem;
		font-weight: 400;
		line-height: 1.8;
	}
	.post-intro span {
		color: #111;
		font-family: var(--font-nunito), sans-serif;
		font-size: clamp(2.2rem, 3.4vw, 3.1rem);
		font-weight: 800;
		line-height: 1;
	}
	.post-content {
		width: 100%;
		max-width: 66ch;
		color: #333;
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.88rem;
		line-height: 1.85;
	}
	.post-content :global(h2) {
		margin: 3rem 0 1rem;
		color: #111;
		font-family: var(--font-nunito), sans-serif;
		font-size: 1.35rem;
		font-weight: 800;
		line-height: 1.15;
	}
	.post-content :global(p) {
		margin: 0 0 1.4rem;
	}
	.post-content :global(h3) {
		margin: 2.4rem 0 0.9rem;
		color: #111;
		font-family: var(--font-nunito), sans-serif;
		font-size: 1.08rem;
		font-weight: 800;
		line-height: 1.2;
	}
	.post-content :global(ul),
	.post-content :global(ol) {
		margin: 0 0 1.6rem;
		padding-left: 1.2rem;
	}
	.post-content :global(li) {
		margin-bottom: 0.45rem;
	}
	.post-content :global(a) {
		color: #111;
		font-weight: 700;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.18em;
	}
	.post-content :global(blockquote) {
		margin: 2rem 0;
		padding: 0.2rem 0 0.2rem 1.2rem;
		border-left: 3px solid #111;
		color: #555;
		font-size: 0.95rem;
	}
	.post-content :global(code) {
		padding: 0.15rem 0.35rem;
		border: 1px solid #e6e4e1;
		border-radius: 4px;
		background: #f8f7f5;
		color: #111;
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.82em;
	}
	.post-content :global(pre) {
		max-width: 100%;
		margin: 2rem 0;
		padding: 1.1rem 1.2rem;
		overflow-x: auto;
		border: 1px solid #e6e4e1;
		border-radius: 8px;
		background: #111;
		color: #f7f7f7;
		line-height: 1.7;
	}
	.post-content :global(pre code) {
		all: unset;
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.82rem;
	}
	.post-content :global(table) {
		display: block;
		width: 100%;
		margin: 2rem 0;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: 0.82rem;
	}
	.post-content :global(th),
	.post-content :global(td) {
		padding: 0.65rem 0.8rem;
		border: 1px solid #e6e4e1;
		text-align: left;
		vertical-align: top;
	}
	.post-content :global(th) {
		background: #f8f7f5;
		color: #111;
		font-family: var(--font-nunito), sans-serif;
		font-weight: 800;
	}
	.post-content :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin: 2rem 0;
		border-radius: 8px;
		cursor: zoom-in;
	}
	.post-content :global(img:focus-visible) {
		outline: 2px solid #111;
		outline-offset: 4px;
	}
	.post-image {
		margin-top: 3rem;
	}
	.post-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
		box-shadow: none;
	}
	.image-viewer {
		width: 100vw;
		max-width: 100vw;
		height: 100vh;
		max-height: 100vh;
		padding: 0;
		margin: 0;
		border: none;
		background: rgba(15, 15, 15, 0.74);
		overflow: hidden;
		opacity: 0;
		backdrop-filter: blur(10px);
		animation: viewer-overlay-in 180ms ease forwards;
	}
	.image-viewer::backdrop {
		background: transparent;
	}
	.image-viewer img {
		position: absolute;
		inset: 50% auto auto 50%;
		transform: translate(-50%, -50%) scale(0.96);
		display: block;
		max-width: min(1120px, calc(100vw - 4rem));
		max-height: calc(100vh - 5rem);
		width: auto;
		height: auto;
		border-radius: 8px;
		box-shadow: 0 24px 80px rgba(0, 0, 0, 35%);
		animation: viewer-image-in 220ms ease forwards;
	}
	.image-viewer[data-closing='true'] {
		animation: viewer-overlay-out 180ms ease forwards;
	}
	.image-viewer[data-closing='true'] img {
		animation: viewer-image-out 180ms ease forwards;
	}
	.image-viewer-close {
		position: fixed;
		top: 1.5rem;
		right: 1.5rem;
		width: 2.4rem;
		height: 2.4rem;
		border: 0;
		background: transparent;
		color: #fff;
		font-family: var(--font-nunito), sans-serif;
		font-size: 1.8rem;
		font-weight: 800;
		line-height: 1;
		cursor: pointer;
		text-shadow: 0 2px 14px rgba(0, 0, 0, 35%);
	}
	.image-viewer-close:hover {
		opacity: 0.72;
	}
	@keyframes viewer-overlay-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@keyframes viewer-overlay-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}
	@keyframes viewer-image-in {
		from {
			opacity: 0;
			transform: translate(-50%, -48%) scale(0.96);
		}
		to {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
	}
	@keyframes viewer-image-out {
		from {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
		to {
			opacity: 0;
			transform: translate(-50%, -48%) scale(0.96);
		}
	}
	@keyframes post-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.post-layout,
		.image-viewer,
		.image-viewer img,
		.image-viewer[data-closing='true'],
		.image-viewer[data-closing='true'] img {
			animation: none;
			opacity: 1;
		}
	}

	@media (max-width: 820px) {
		.post-shell {
			padding-top: 4.5rem;
		}
		.back-link {
			top: 1.3rem;
		}
		.post-layout {
			grid-template-columns: 1fr;
			gap: 2.75rem;
		}
		.post-hero {
			min-height: auto;
			gap: 3rem;
			padding-top: 0;
		}
		.post-hero h1 {
			max-width: 14ch;
		}
		.post-intro {
			grid-template-columns: 1fr;
			margin-bottom: 3.5rem;
		}
		.post-intro span {
			order: -1;
		}
	}
</style>
