---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroUrl from '../assets/hero.svg?url';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="home">
			<Header />
			<main class="hero">
				<div class="hero-text">
					<h1>I build software,<br />and write about it.</h1>
					<p class="lead">
						I'm a developer, and this is my space to think out loud. I
						write about what I build, what I learn along the way, and the
						mistakes that teach me more than the wins.
					</p>
					<a class="cta" href="/blog">Explore</a>
				</div>

				<div class="hero-media">
					<img src={heroUrl} alt="Workspace illustration" class="hero-img" />
				</div>
			</main>
		</div>
	</body>
</html>

<style>
	/* Single-screen layout without scroll on desktop */
	.home {
		height: 100vh;
		background: #ffffff;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.hero {
		flex: 1 1 auto;
		min-height: 0;
		width: min(1200px, 100% - 3em);
		max-width: none;
		margin-inline: auto;
		padding: 0 0 2vh;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
		animation: fade-up 0.5s ease both;
	}

	.hero-text h1 {
		font-family: var(--font-nunito), sans-serif;
		font-size: clamp(2.25rem, 5vw, 4rem);
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.08;
		margin-bottom: 1.5rem;
		color: #111;
	}

	.lead {
		font-family: var(--font-typewriter), ui-monospace, monospace;
		font-size: 0.85rem;
		font-weight: 400;
		line-height: 1.7;
		letter-spacing: -0.01em;
		color: #444240;
		max-width: 46ch;
		margin-bottom: 2.5rem;
	}

	.cta {
		display: inline-block;
		background: #111;
		color: #FFFFFF;
		text-decoration: none;
		font-weight: 500;
		font-size: 1rem;
		padding: 1em 3em;
		border-radius: 999px;
		transition:
			transform 0.15s ease,
			background 0.15s ease;
	}
	.cta:hover {
		background: #000;
		color: #FFFFFF;
		transform: translateY(-2px);
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero {
			animation: none;
		}
	}

	/* Image side */
	.hero-media {
		display: flex;
		justify-content: center;
		align-items: center;
		height: 100%;
		min-height: 0;
	}
	.hero-img {
		height: 88%;
		width: auto;
		max-width: 100%;
		object-fit: contain;
	}

	/* Responsive single-column layout on mobile, with scrolling enabled */
	@media (max-width: 720px) {
		.home {
			height: auto;
			min-height: 100vh;
			overflow: visible;
		}
		.hero {
			grid-template-columns: 1fr;
			gap: 2rem;
			align-content: center;
			padding: 1.5em 0 3em;
		}
		.hero-media {
			order: -1;
			height: auto;
		}
		.hero-img {
			height: auto;
			width: 240px;
			max-width: 70vw;
		}
	}
</style>
